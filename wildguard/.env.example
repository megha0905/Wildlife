# Copy to .env and adjust. Never commit .env.
# docker-compose reads .env automatically. Spring Boot does NOT: export these in your shell
# or add them to your IDE run configuration (see README).

# ---- Security (required, same value for gateway and every service, at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# ---- PostgreSQL (docker-compose)
POSTGRES_USER=wildguard
POSTGRES_PASSWORD=wildguard

# ---- Database connection used by the services (must match the two above)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wildguard
DB_PASSWORD=wildguard

# ---- Time zone for "today" and "current month"
APP_TIMEZONE=Asia/Kolkata

# ---- Service URLs (gateway routes and Feign clients)
AUTH_SERVICE_URL=http://localhost:8081
HABITAT_SERVICE_URL=http://localhost:8082
WILDLIFE_SERVICE_URL=http://localhost:8083
RESOURCE_SERVICE_URL=http://localhost:8084
PATROL_SERVICE_URL=http://localhost:8085
INCIDENT_SERVICE_URL=http://localhost:8086
RESCUE_SERVICE_URL=http://localhost:8087
PROGRAMME_SERVICE_URL=http://localhost:8088
REPORTING_SERVICE_URL=http://localhost:8089

# ---- Gateway CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend (Vite reads frontend/.env; copy this line there)
VITE_API_BASE_URL=http://localhost:8080
